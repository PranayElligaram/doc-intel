# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never carry a real value.

# Companies House REST API key. Free. Register an application at
# developer.company-information.service.gov.uk, create a "REST API" key, and
# paste it here. It is sent as HTTP Basic auth with the key as the username and
# an empty password - that is what the API expects, not a bearer token.
COMPANIES_HOUSE_API_KEY=
